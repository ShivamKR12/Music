#:import get_color_from_hex kivy.utils.get_color_from_hex

<PlayerScreen>:
    name: "player"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            texture: app.player_background_texture
            pos: self.pos
            size: self.size

    MDFloatLayout:
        # Subtle particle overlay (kept for settings toggle compatibility; disabled by default)
        AnimatedBackground:
            id: player_animated_bg
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}
            opacity: 0.12 if app.animated_bg_enabled else 0
            is_active: app.animated_bg_enabled
            variation: app.animated_bg_variation
            speed: app.animated_bg_speed

        MDBoxLayout:
            orientation: "vertical"
            padding: ["16dp", "0dp", "16dp", "16dp"]
            spacing: "8dp"

            # 1. Top App Bar (SimpMusic CenterAlignedTopAppBar parity: transparent, clean white text)
            MDTopAppBar:
                type: "small"
                theme_bg_color: "Custom"
                md_bg_color: [0, 0, 0, 0]
                theme_shadow_color: "Custom"
                shadow_color: [0, 0, 0, 0]
                elevation_level: 0
                MDTopAppBarLeadingButtonContainer:
                    MDActionTopAppBarButton:
                        icon: "chevron-down"
                        theme_icon_color: "Custom"
                        icon_color: [1, 1, 1, 0.95]
                        on_release: app.go_back()
                MDTopAppBarTitle:
                    text: app.active_playlist_name.upper() if app.active_playlist_name else "NOW PLAYING"
                    font_style: "Title"
                    role: "large"
                    bold: True
                    halign: "center"
                    pos_hint: {"center_x": .5}
                    theme_text_color: "Custom"
                    text_color: [1, 1, 1, 0.95]
                MDTopAppBarTrailingButtonContainer:
                    MDActionTopAppBarButton:
                        icon: "heart" if app.player_controller.is_favorite else "heart-outline"
                        theme_icon_color: "Custom"
                        icon_color: get_color_from_hex("#FF4081") if app.player_controller.is_favorite else [1, 1, 1, 0.90]
                        on_release: app.player_controller.toggle_favorite()
                    MDActionTopAppBarButton:
                        icon: "text-box-outline"
                        theme_icon_color: "Custom"
                        icon_color: [1, 1, 1, 0.90]
                        on_release: app.show_lyrics()
                    MDActionTopAppBarButton:
                        icon: "dots-vertical"
                        theme_icon_color: "Custom"
                        icon_color: [1, 1, 1, 0.95]
                        on_release: app.show_track_options()

            # 2. Centered Square Artwork Carousel (SimpMusic Pager parity: centered 230x230dp)
            MDBoxLayout:
                size_hint_y: 1
                pos_hint: {"center_x": .5}

                Carousel:
                    id: album_carousel
                    size_hint: (1, 1)
                    pos_hint: {"center_x": .5, "center_y": .5}
                    on_index: app.on_carousel_index(self.index)

            # 3. Inline Synchronized Lyric Teaser (SimpMusic Spotify-style inline lyric)
            MDCard:
                style: "filled"
                size_hint: None, None
                size: "320dp", "30dp"
                pos_hint: {"center_x": .5}
                radius: [dp(15)]
                theme_bg_color: "Custom"
                md_bg_color: [1, 1, 1, 0.08]
                padding: ["12dp", "0dp"]
                ripple_behavior: True
                on_release: app.show_lyrics()
                MDBoxLayout:
                    spacing: "8dp"
                    pos_hint: {"center_y": .5}
                    MDIcon:
                        icon: "microphone-variant"
                        adaptive_size: True
                        pos_hint: {"center_y": .5}
                        theme_icon_color: "Custom"
                        icon_color: app.theme_cls.primaryColor
                    MarqueeLabel:
                        text: app.current_lyric_line
                        font_style: "Body"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 0.90]
                        height: "20dp"
                        pos_hint: {"center_y": .5}

            # 4. Track Info & Favorite Heart Row (SimpMusic NowPlayingTrackInfoRow)
            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "48dp"
                spacing: "8dp"
                padding: ["8dp", "0dp"]

                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    pos_hint: {"center_y": .5}
                    spacing: "1dp"

                    MarqueeLabel:
                        text: app.player_controller.active_track.title if app.player_controller.active_track else "No Track"
                        font_style: "Title"
                        role: "large"
                        bold: True
                        halign: "left"
                        height: "26dp"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 1.0]

                    MarqueeLabel:
                        text: app.player_controller.active_track.artist if app.player_controller.active_track else "Unknown"
                        font_style: "Body"
                        role: "medium"
                        halign: "left"
                        height: "18dp"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 0.70]

                MDIconButton:
                    icon: "heart" if app.player_controller.is_favorite else "heart-outline"
                    pos_hint: {"center_y": .5}
                    theme_icon_color: "Custom"
                    icon_color: get_color_from_hex("#FF4081") if app.player_controller.is_favorite else [1, 1, 1, 0.70]
                    on_release: app.player_controller.toggle_favorite()

            # 5. Timeline Slider & Timestamps (SimpMusic SpotifyPlaybackControls)
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "0dp"
                padding: ["4dp", "0dp"]

                PlayerTimelineSlider:
                    id: timeline_slider
                    value: app.player_controller.current_time if (app.player_controller and not self.is_seeking) else self.value
                    min: 0
                    max: app.player_controller.duration if (app.player_controller and app.player_controller.duration > 0) else 100
                    size_hint_y: None
                    height: "32dp"
                    track_active_color: app.theme_cls.primaryColor
                    track_inactive_color: [1, 1, 1, 0.18]
                    pos_hint: {"center_y": .5}
                    handle_anim_duration: 0
                    handle_anim_transition: "linear"

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "14dp"
                    padding: ["4dp", "0dp"]

                    MDLabel:
                        id: player_current_time_label
                        text: app.player_controller.formatted_current_time if app.player_controller else "00:00"
                        font_style: "Label"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 0.65]
                        adaptive_width: True
                        pos_hint: {"center_y": .5}

                    Widget:

                    MDLabel:
                        id: player_duration_label
                        text: app.player_controller.formatted_duration if app.player_controller else "00:00"
                        font_style: "Label"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 0.65]
                        adaptive_width: True
                        pos_hint: {"center_y": .5}

            # 6. Transport Controls (SimpMusic PlayerControlLayout parity)
            MDBoxLayout:
                orientation: "horizontal"
                adaptive_size: True
                spacing: "16dp"
                pos_hint: {"center_x": .5}

                MDIconButton:
                    icon: "shuffle-variant" if app.player_controller.is_shuffle else "shuffle-disabled"
                    pos_hint: {"center_y": .5}
                    theme_icon_color: "Custom"
                    icon_color: app.theme_cls.primaryColor if app.player_controller.is_shuffle else [1, 1, 1, 0.65]
                    on_release: app.player_controller.toggle_shuffle()

                MDIconButton:
                    icon: "skip-previous"
                    pos_hint: {"center_y": .5}
                    theme_icon_color: "Custom"
                    icon_color: [1, 1, 1, 1.0]
                    on_release: app.player_controller.prev_track()

                MDFabButton:
                    icon: "pause" if app.player_controller.is_playing else "play"
                    style: "standard"
                    theme_bg_color: "Custom"
                    md_bg_color: [1, 1, 1, 1.0]
                    theme_icon_color: "Custom"
                    icon_color: [0, 0, 0, 1.0]
                    pos_hint: {"center_y": .5}
                    on_release: app.player_controller.toggle_play()

                MDIconButton:
                    icon: "skip-next"
                    pos_hint: {"center_y": .5}
                    theme_icon_color: "Custom"
                    icon_color: [1, 1, 1, 1.0]
                    on_release: app.player_controller.next_track()

                MDIconButton:
                    icon: "repeat-once" if app.player_controller.repeat_mode == "one" else ("repeat" if app.player_controller.repeat_mode == "all" else "repeat-off")
                    pos_hint: {"center_y": .5}
                    theme_icon_color: "Custom"
                    icon_color: app.theme_cls.primaryColor if app.player_controller.is_repeat else [1, 1, 1, 0.65]
                    on_release: app.player_controller.toggle_repeat()

            # 7. YouTube Music / SimpMusic Style Up-Next Bottom Pill (Translucent Frosted Card)
            MDCard:
                id: up_next_pill
                style: "filled"
                size_hint_y: None
                height: "48dp"
                radius: [dp(24)]
                theme_bg_color: "Custom"
                md_bg_color: [1, 1, 1, 0.10]
                padding: ["16dp", "0dp"]
                ripple_behavior: True
                pos_hint: {"center_x": .5}
                on_release: app.show_queue_sheet()

                MDBoxLayout:
                    spacing: "8dp"
                    pos_hint: {"center_y": .5}

                    MDIcon:
                        icon: "playlist-play"
                        adaptive_size: True
                        pos_hint: {"center_y": .5}
                        theme_icon_color: "Custom"
                        icon_color: app.theme_cls.primaryColor

                    MDLabel:
                        text: "UP NEXT"
                        font_style: "Label"
                        role: "large"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 0.95]
                        pos_hint: {"center_y": .5}

                    Widget:

                    MDLabel:
                        text: f"{len(app.player_controller.queue)} tracks" if app.player_controller else ""
                        font_style: "Label"
                        role: "medium"
                        halign: "right"
                        adaptive_width: True
                        theme_text_color: "Custom"
                        text_color: [1, 1, 1, 0.65]
                        pos_hint: {"center_y": .5}

                    MDIcon:
                        icon: "chevron-up"
                        adaptive_size: True
                        pos_hint: {"center_y": .5}
                        theme_icon_color: "Custom"
                        icon_color: [1, 1, 1, 0.70]
