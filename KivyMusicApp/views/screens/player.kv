<PlayerScreen>:
    name: "player"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "chevron-down"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "NOW PLAYING"
                font_style: "Body"
                role: "small"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "dots-vertical"
                    on_release: app.show_track_options()

        MDBoxLayout:
            orientation: "vertical"
            padding: "24dp"
            spacing: "16dp"

            Carousel:
                id: album_carousel
                size_hint: 1, 1
                pos_hint: {"center_x": .5}
                on_index: app.on_carousel_index(self.index)

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "4dp"
                MarqueeLabel:
                    text: app.player_controller.active_track.title if app.player_controller.active_track else "No Track"
                    font_style: "Title"
                    role: "large"
                    bold: True
                    halign: "center"
                    height: "32dp"
                MarqueeLabel:
                    text: app.player_controller.active_track.artist if app.player_controller.active_track else "Unknown"
                    font_style: "Body"
                    role: "medium"
                    halign: "center"
                    text_color: app.theme_cls.onSurfaceVariantColor
                    height: "22dp"

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.player_controller.active_track.formatted_current_time if app.player_controller.active_track else "00:00"
                    font_style: "Body"
                    role: "small"
                    text_color: app.theme_cls.onSurfaceVariantColor
                    adaptive_width: True
                MDSlider:
                    value: app.player_controller.active_track.current_time if app.player_controller.active_track else 0
                    min: 0
                    max: app.player_controller.active_track.duration if app.player_controller.active_track else 100
                    on_value: if app.player_controller.active_track: app.player_controller.active_track.current_time = self.value
                    size_hint_y: None
                    height: "4dp"
                    pos_hint: {"center_y": .5}
                MDLabel:
                    text: app.player_controller.active_track.formatted_duration if app.player_controller.active_track else "00:00"
                    font_style: "Body"
                    role: "small"
                    text_color: app.theme_cls.onSurfaceVariantColor
                    adaptive_width: True

            MDBoxLayout:
                adaptive_size: True
                spacing: "16dp"
                pos_hint: {"center_x": .5}

                MDIconButton:
                    icon: "shuffle"
                    pos_hint: {"center_y": .5}
                    theme_icon_color: "Custom" if app.player_controller.is_shuffle else "Primary"
                    icon_color: app.theme_cls.primaryColor if app.player_controller.is_shuffle else app.theme_cls.onSurfaceVariantColor
                    on_release: app.player_controller.toggle_shuffle()
                MDIconButton:
                    icon: "skip-previous"
                    pos_hint: {"center_y": .5}
                    on_release: app.player_controller.prev_track()
                    
                MDFabButton:
                    icon: "pause" if app.player_controller.is_playing else "play"
                    style: "standard"
                    color_map: "tertiary"
                    pos_hint: {"center_y": .5}
                    on_release: app.player_controller.toggle_play()

                MDIconButton:
                    icon: "skip-next"
                    pos_hint: {"center_y": .5}
                    on_release: app.player_controller.next_track()
                MDIconButton:
                    icon: "repeat"
                    pos_hint: {"center_y": .5}
                    theme_icon_color: "Custom" if app.player_controller.is_repeat else "Primary"
                    icon_color: app.theme_cls.primaryColor if app.player_controller.is_repeat else app.theme_cls.onSurfaceVariantColor
                    on_release: app.player_controller.toggle_repeat()
                    
            # YouTube Music Style Up-Next Bottom Pill
            MDCard:
                style: "filled"
                size_hint_y: None
                height: "48dp"
                radius: [dp(24)]
                md_bg_color: app.theme_cls.surfaceContainerHighestColor
                padding: ["16dp", "0dp"]
                ripple_behavior: True
                pos_hint: {"center_x": .5}
                on_release: app.show_queue_sheet()

                MDBoxLayout:
                    spacing: "8dp"
                    pos_hint: {"center_y": .5}
                    MDIcon:
                        icon: "playlist-play"
                        pos_hint: {"center_y": .5}
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primaryColor
                    MDLabel:
                        text: "UP NEXT"
                        font_style: "Label"
                        role: "large"
                        bold: True
                        pos_hint: {"center_y": .5}
                    Widget:
                    MDLabel:
                        text: f"{len(app.playlist_model.tracks)} tracks" if app.playlist_model else ""
                        font_style: "Label"
                        role: "medium"
                        halign: "right"
                        adaptive_width: True
                        text_color: app.theme_cls.onSurfaceVariantColor
                        pos_hint: {"center_y": .5}
                    MDIcon:
                        icon: "chevron-up"
                        adaptive_width: True
                        pos_hint: {"center_y": .5}

