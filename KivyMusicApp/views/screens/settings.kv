<SettingsScreen>:
    name: "settings"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Settings"
                
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: "24dp"
                spacing: "24dp"

                MDList:
                    MDListItem:
                        on_release: app.show_audio_quality_dialog()
                        MDListItemHeadlineText:
                            text: "Audio Quality"
                        MDListItemSupportingText:
                            text: app.selected_audio_quality
                        MDListItemTrailingIcon:
                            icon: "chevron-right"
                            
                    MDListItem:
                        on_release: wifi_checkbox.active = not wifi_checkbox.active
                        MDListItemHeadlineText:
                            text: "Download over Wi-Fi only"
                        MDListItemSupportingText:
                            text: "Save mobile data"
                        MDListItemTrailingCheckbox:
                            id: wifi_checkbox
                            active: True

                    MDListItem:
                        on_release: dark_checkbox.active = not dark_checkbox.active
                        MDListItemHeadlineText:
                            text: "Dark Mode"
                        MDListItemSupportingText:
                            text: "Toggle app theme"
                        MDListItemTrailingCheckbox:
                            id: dark_checkbox
                            active: app.theme_cls.theme_style == "Dark"
                            on_active: app.toggle_theme_style(self.active)
                            
                    MDListItem:
                        on_release: sponsor_checkbox.active = not sponsor_checkbox.active
                        MDListItemHeadlineText:
                            text: "SponsorBlock"
                        MDListItemSupportingText:
                            text: "Skip non-music segments"
                        MDListItemTrailingCheckbox:
                            id: sponsor_checkbox
                            active: True
                            
                    MDListItem:
                        on_release: app.switch_screen("equalizer")
                        MDListItemHeadlineText:
                            text: "Equalizer"
                        MDListItemSupportingText:
                            text: "Adjust audio frequencies"
                        MDListItemTrailingIcon:
                            icon: "chevron-right"
                            
                    MDListItem:
                        on_release: app.show_clear_cache_dialog()
                        MDListItemHeadlineText:
                            text: "Clear Cache"
                        MDListItemSupportingText:
                            text: "Free up storage space"
                        MDListItemTrailingIcon:
                            icon: "delete-outline"

