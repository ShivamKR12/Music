<SearchScreen>:
    name: "search"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Search"
                
        MDBoxLayout:
            orientation: "vertical"
            padding: ["16dp", "16dp", "16dp", "24dp"]
            spacing: "16dp"
            
            MDTextField:
                id: search_input
                mode: "outlined"
                on_text_validate: app.perform_search(self.text)
                MDTextFieldHintText:
                    text: "Search songs, artists, podcasts..."
                MDTextFieldLeadingIcon:
                    icon: "magnify"
                MDTextFieldTrailingIcon:
                    icon: "close"
                    on_touch_down: if self.collide_point(*args[1].pos): search_input.text = ""; app.clear_search_results()

            # Browse Category Chips
            DirectionalHorizontalScrollView:
                size_hint_y: None
                height: "48dp"
                do_scroll_y: False
                do_scroll_x: True
                bar_width: "2dp"
                MDBoxLayout:
                    adaptive_size: True
                    height: "48dp"
                    padding: ["8dp", "8dp", "8dp", "8dp"]
                    spacing: "8dp"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Pop"; app.perform_search("Pop")
                        MDChipText:
                            text: "Pop"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Hip-Hop"; app.perform_search("Hip-Hop")
                        MDChipText:
                            text: "Hip-Hop"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Rock"; app.perform_search("Rock")
                        MDChipText:
                            text: "Rock"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Bollywood"; app.perform_search("Bollywood")
                        MDChipText:
                            text: "Bollywood"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Punjabi"; app.perform_search("Punjabi")
                        MDChipText:
                            text: "Punjabi"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Indie"; app.perform_search("Indie")
                        MDChipText:
                            text: "Indie"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Podcasts"; app.perform_search("Podcasts")
                        MDChipText:
                            text: "Podcasts"

            # Results Section Header
            MDBoxLayout:
                id: results_header_box
                adaptive_height: True
                opacity: 1 if search_results_list.data else 0
                height: self.minimum_height if search_results_list.data else 0
                MDLabel:
                    id: search_status_label
                    text: "Search Results"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

            # Results List
            RecycleView:
                id: search_results_list
                viewclass: "TrackListItem"
                data: []
                size_hint_y: 1 if self.data else None
                height: dp(260) if self.data else 0
                opacity: 1 if self.data else 0
                RecycleBoxLayout:
                    default_size: None, dp(64)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(8)

            MDBoxLayout:
                id: history_header_box
                adaptive_height: True
                opacity: 1 if not search_results_list.data else 0
                height: self.minimum_height if not search_results_list.data else 0
                MDLabel:
                    text: "Recent searches"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True
                MDButton:
                    style: "text"
                    on_release: app.clear_search_history()
                    MDButtonText:
                        text: "Clear search history"
                        
            RecycleView:
                id: search_history_list
                viewclass: "SearchHistoryItem"
                data: [{"text": "unstoppable"}, {"text": "haryanvi songs"}]
                size_hint_y: 1 if not search_results_list.data else None
                height: dp(200) if not search_results_list.data else 0
                opacity: 1 if not search_results_list.data else 0
                RecycleBoxLayout:
                    default_size: None, dp(56)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(8)
