<AnalyticsScreen>:
    name: "analytics"
    md_bg_color: app.theme_cls.backgroundColor
    
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Analytics"
                font_style: "Headline"
                role: "large"
                
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: ["16dp", "16dp", "16dp", "88dp"]
                spacing: "20dp"
                adaptive_height: True
                
                MDLabel:
                    text: "Your Listening Insights"
                    font_style: "Title"
                    role: "large"
                    bold: True
                    adaptive_height: True

                # Top Summary Metric Cards (2x2 Grid)
                MDGridLayout:
                    cols: 2
                    spacing: "12dp"
                    adaptive_height: True

                    MDCard:
                        style: "elevated"
                        padding: "16dp"
                        adaptive_height: True
                        orientation: "vertical"
                        MDLabel:
                            text: "Total Tracks"
                            font_style: "Label"
                            role: "medium"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True
                        MDLabel:
                            text: root.total_tracks_text
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            adaptive_height: True
                            text_color: app.theme_cls.primaryColor

                    MDCard:
                        style: "elevated"
                        padding: "16dp"
                        adaptive_height: True
                        orientation: "vertical"
                        MDLabel:
                            text: "Total Artists"
                            font_style: "Label"
                            role: "medium"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True
                        MDLabel:
                            text: root.total_artists_text
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            adaptive_height: True
                            text_color: app.theme_cls.secondaryColor

                    MDCard:
                        style: "elevated"
                        padding: "16dp"
                        adaptive_height: True
                        orientation: "vertical"
                        MDLabel:
                            text: "Music Library Duration"
                            font_style: "Label"
                            role: "medium"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True
                        MDLabel:
                            text: root.total_playtime_text
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            adaptive_height: True
                            text_color: app.theme_cls.tertiaryColor

                    MDCard:
                        style: "elevated"
                        padding: "16dp"
                        adaptive_height: True
                        orientation: "vertical"
                        MDLabel:
                            text: "Last Played Track"
                            font_style: "Label"
                            role: "medium"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True
                        MDLabel:
                            text: root.most_played_text
                            font_style: "Title"
                            role: "medium"
                            bold: True
                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"
                    
                # A card representing a Bar Chart using Box Layouts
                MDCard:
                    style: "elevated"
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: "250dp"
                    
                    MDLabel:
                        text: "Weekly Activity"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                        
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: "8dp"
                        # Monday
                        MDBoxLayout:
                            orientation: "vertical"
                            MDBoxLayout:
                            MDBoxLayout:
                                md_bg_color: app.theme_cls.primaryColor
                                size_hint_y: max(0.08, root.bar_mon_h)
                                radius: [dp(4), dp(4), 0, 0]
                            MDLabel:
                                text: "M"
                                halign: "center"
                                adaptive_height: True
                        # Tuesday
                        MDBoxLayout:
                            orientation: "vertical"
                            MDBoxLayout:
                            MDBoxLayout:
                                md_bg_color: app.theme_cls.primaryColor
                                size_hint_y: max(0.08, root.bar_tue_h)
                                radius: [dp(4), dp(4), 0, 0]
                            MDLabel:
                                text: "T"
                                halign: "center"
                                adaptive_height: True
                        # Wednesday
                        MDBoxLayout:
                            orientation: "vertical"
                            MDBoxLayout:
                            MDBoxLayout:
                                md_bg_color: app.theme_cls.primaryColor
                                size_hint_y: max(0.08, root.bar_wed_h)
                                radius: [dp(4), dp(4), 0, 0]
                            MDLabel:
                                text: "W"
                                halign: "center"
                                adaptive_height: True
                        # Thursday
                        MDBoxLayout:
                            orientation: "vertical"
                            MDBoxLayout:
                            MDBoxLayout:
                                md_bg_color: app.theme_cls.primaryColor
                                size_hint_y: max(0.08, root.bar_thu_h)
                                radius: [dp(4), dp(4), 0, 0]
                            MDLabel:
                                text: "T"
                                halign: "center"
                                adaptive_height: True
                        # Friday
                        MDBoxLayout:
                            orientation: "vertical"
                            MDBoxLayout:
                            MDBoxLayout:
                                md_bg_color: app.theme_cls.primaryColor
                                size_hint_y: max(0.08, root.bar_fri_h)
                                radius: [dp(4), dp(4), 0, 0]
                            MDLabel:
                                text: "F"
                                halign: "center"
                                adaptive_height: True
                        # Saturday
                        MDBoxLayout:
                            orientation: "vertical"
                            MDBoxLayout:
                            MDBoxLayout:
                                md_bg_color: app.theme_cls.primaryColor
                                size_hint_y: max(0.08, root.bar_sat_h)
                                radius: [dp(4), dp(4), 0, 0]
                            MDLabel:
                                text: "S"
                                halign: "center"
                                adaptive_height: True
                        # Sunday
                        MDBoxLayout:
                            orientation: "vertical"
                            MDBoxLayout:
                            MDBoxLayout:
                                md_bg_color: app.theme_cls.primaryColor
                                size_hint_y: max(0.08, root.bar_sun_h)
                                radius: [dp(4), dp(4), 0, 0]
                            MDLabel:
                                text: "S"
                                halign: "center"
                                adaptive_height: True

                # Top Artists Breakdown Donut Chart
                MDCard:
                    style: "elevated"
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: "260dp"
                    
                    MDLabel:
                        text: "Top Artists Breakdown"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                        
                    MDFloatLayout:
                        canvas:
                            # Segment 1
                            Color:
                                rgba: app.theme_cls.primaryColor
                            Ellipse:
                                pos: self.center_x - dp(70), self.center_y - dp(70)
                                size: dp(140), dp(140)
                                angle_start: 0
                                angle_end: root.segment_1_end
                            # Segment 2
                            Color:
                                rgba: app.theme_cls.secondaryColor
                            Ellipse:
                                pos: self.center_x - dp(70), self.center_y - dp(70)
                                size: dp(140), dp(140)
                                angle_start: root.segment_1_end
                                angle_end: root.segment_2_end
                            # Segment 3
                            Color:
                                rgba: app.theme_cls.tertiaryColor
                            Ellipse:
                                pos: self.center_x - dp(70), self.center_y - dp(70)
                                size: dp(140), dp(140)
                                angle_start: root.segment_2_end
                                angle_end: root.segment_3_end
                            # Donut Center Cutout
                            Color:
                                rgba: app.theme_cls.surfaceContainerColor
                            Ellipse:
                                pos: self.center_x - dp(45), self.center_y - dp(45)
                                size: dp(90), dp(90)
                    
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "8dp"
                        MDLabel:
                            text: root.segment_1_name + " (" + root.segment_1_pct + ")"
                            text_color: app.theme_cls.primaryColor
                            halign: "center"
                            shorten: True
                            shorten_from: "right"
                        MDLabel:
                            text: root.segment_2_name + " (" + root.segment_2_pct + ")"
                            text_color: app.theme_cls.secondaryColor
                            halign: "center"
                            shorten: True
                            shorten_from: "right"
                        MDLabel:
                            text: root.segment_3_name + " (" + root.segment_3_pct + ")"
                            text_color: app.theme_cls.tertiaryColor
                            halign: "center"
                            shorten: True
                            shorten_from: "right"
