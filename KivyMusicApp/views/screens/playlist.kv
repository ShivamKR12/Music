<PlaylistScreen>
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
            MDTopAppBarTitle:
                text: "Playlist"
                
        MDScrollView:
            MDGridLayout:
                cols: 2
                adaptive_height: True
                padding: "16dp"
                spacing: "16dp"
                
                MDCard:
                    size_hint_y: None
                    height: "150dp"
                    MDBoxLayout:
                        orientation: "vertical"
                        FitImage:
                            source: ""
                        MDLabel:
                            text: "Track 1"
                            halign: "center"
                            adaptive_height: True
