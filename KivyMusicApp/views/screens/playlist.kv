<PlaylistScreen>:
    name: "playlist"
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: app.active_playlist_name or "Playlist"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "plus"
                    on_release: app.show_add_to_active_playlist_sheet()
                MDActionTopAppBarButton:
                    icon: "dots-vertical"
                    on_release: app.show_playlist_options()

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "88dp"]
                spacing: "20dp"

                # Playlist Header Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(24)]
                    padding: "20dp"
                    spacing: "16dp"
                    orientation: "vertical"
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    FitImage:
                        id: playlist_art
                        source: app.active_playlist_artwork or "album_art2.png"
                        size_hint: None, None
                        size: "180dp", "180dp"
                        radius: [dp(16)]
                        pos_hint: {"center_x": .5}

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "4dp"
                        MDLabel:
                            text: app.active_playlist_name or "Playlist"
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            halign: "center"
                            adaptive_height: True
                        MDLabel:
                            text: "Custom Playlist"
                            font_style: "Title"
                            role: "medium"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primaryColor
                            adaptive_height: True
                        MDLabel:
                            text: app.active_playlist_info or "0 tracks"
                            font_style: "Body"
                            role: "small"
                            halign: "center"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True

                    MDBoxLayout:
                        adaptive_size: True
                        spacing: "8dp"
                        pos_hint: {"center_x": .5}
                        MDButton:
                            style: "filled"
                            on_release: app.play_active_playlist(shuffle=False)
                            MDButtonIcon:
                                icon: "play"
                            MDButtonText:
                                text: "Play All"
                        MDButton:
                            style: "tonal"
                            on_release: app.play_active_playlist(shuffle=True)
                            MDButtonIcon:
                                icon: "shuffle"
                            MDButtonText:
                                text: "Shuffle"
                        MDIconButton:
                            style: "outlined"
                            icon: "download-outline"
                            pos_hint: {"center_y": .5}
                            on_release: app.download_active_playlist()

                # Section Header: Tracks
                MDBoxLayout:
                    adaptive_height: True
                    MDLabel:
                        text: "Tracks"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                    Widget:
                    MDButton:
                        style: "text"
                        on_release: app.show_add_to_active_playlist_sheet()
                        MDButtonIcon:
                            icon: "plus"
                        MDButtonText:
                            text: "Add Songs"

                MDLabel:
                    text: "No tracks in this playlist yet.\nTap 'Add Songs' to add music!"
                    opacity: 1 if len(playlist_tracks_list.data) == 0 else 0
                    adaptive_height: True
                    halign: "center"
                    font_style: "Body"
                    role: "medium"
                    text_color: app.theme_cls.onSurfaceVariantColor

                # Real Dynamic Tracks List
                RecycleView:
                    id: playlist_tracks_list
                    viewclass: "TrackListItem"
                    size_hint_y: None
                    height: max(dp(72), (dp(72) + dp(16)) * len(self.data)) if self.data else 0
                    RecycleBoxLayout:
                        default_size: None, dp(72)
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height
                        orientation: 'vertical'
                        spacing: dp(16)
