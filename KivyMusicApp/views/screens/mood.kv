                    MDLabel:
                        text: "Sleep & Ambient"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                    MDLabel:
                        text: "Gentle soundscapes"
                        font_style: "Body"
                        role: "small"
