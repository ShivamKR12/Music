<MoodScreen>:
    name: "mood"
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Moods & Genres"

        MDScrollView:
            MDGridLayout:
                cols: 2
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "32dp"]
                spacing: "16dp"

                # Chill & Relax
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    height: "125dp"
                    radius: [dp(20)]
                    padding: "16dp"
                    spacing: "6dp"
                    orientation: "vertical"
                    ripple_behavior: True
                    on_release: app.switch_screen("playlist")
                    md_bg_color: app.theme_cls.surfaceContainerLowColor

                    MDIcon:
                        icon: "coffee-outline"
                        font_size: "28sp"
                        theme_text_color: "Custom"
                        text_color: [0.3, 0.75, 0.85, 1]
                    MDLabel:
                        text: "Chill & Relax"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                    MDLabel:
                        text: "Unwind & calm vibes"
                        font_style: "Body"
                        role: "small"
                        text_color: app.theme_cls.onSurfaceVariantColor
                        adaptive_height: True

                # Workout & Energy
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    height: "125dp"
                    radius: [dp(20)]
                    padding: "16dp"
                    spacing: "6dp"
                    orientation: "vertical"
                    ripple_behavior: True
                    on_release: app.switch_screen("playlist")
                    md_bg_color: app.theme_cls.surfaceContainerLowColor

                    MDIcon:
                        icon: "lightning-bolt-outline"
                        font_size: "28sp"
                        theme_text_color: "Custom"
                        text_color: [1.0, 0.55, 0.2, 1]
                    MDLabel:
                        text: "Workout & Pump"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                    MDLabel:
                        text: "High-BPM fuel"
                        font_style: "Body"
                        role: "small"
                        text_color: app.theme_cls.onSurfaceVariantColor
                        adaptive_height: True

                # Deep Focus
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    height: "125dp"
                    radius: [dp(20)]
                    padding: "16dp"
                    spacing: "6dp"
                    orientation: "vertical"
                    ripple_behavior: True
                    on_release: app.switch_screen("playlist")
                    md_bg_color: app.theme_cls.surfaceContainerLowColor

                    MDIcon:
                        icon: "brain"
                        font_size: "28sp"
                        theme_text_color: "Custom"
                        text_color: [0.55, 0.45, 0.95, 1]
                    MDLabel:
                        text: "Deep Focus"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                    MDLabel:
                        text: "Study & concentration"
                        font_style: "Body"
                        role: "small"
                        text_color: app.theme_cls.onSurfaceVariantColor
                        adaptive_height: True

                # Sleep & Ambient
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    height: "125dp"
                    radius: [dp(20)]
                    padding: "16dp"
                    spacing: "6dp"
                    orientation: "vertical"
                    ripple_behavior: True
                    on_release: app.switch_screen("playlist")
                    md_bg_color: app.theme_cls.surfaceContainerLowColor

                    MDIcon:
                        icon: "weather-night"
