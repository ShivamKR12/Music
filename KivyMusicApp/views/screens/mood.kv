<MoodScreen>
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                text: "Mood & Genres"
                
        MDScrollView:
            MDGridLayout:
                cols: 3
                adaptive_height: True
                padding: "16dp"
                spacing: "16dp"
                
                MDCard:
                    size_hint_y: None
                    height: "100dp"
                    md_bg_color: 0.2, 0.5, 0.8, 1
                    MDLabel:
                        text: "Chill"
                        halign: "center"
                        
                        text_color: 1, 1, 1, 1
