#:import get_color_from_hex kivy.utils.get_color_from_hex

<FavoritesScreen>:
    name: "favorites"
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Favorite Songs"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "share-variant-outline"
                MDActionTopAppBarButton:
                    icon: "dots-vertical"

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "32dp"]
                spacing: "20dp"

                # Header Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(24)]
                    padding: "20dp"
                    spacing: "16dp"
                    orientation: "vertical"
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    MDCard:
                        style: "filled"
                        size_hint: None, None
                        size: "140dp", "140dp"
                        radius: [dp(20)]
                        pos_hint: {"center_x": .5}
                        md_bg_color: get_color_from_hex("#ff5252")

                        MDIcon:
                            icon: "heart"
                            font_size: "64sp"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            theme_icon_color: "Custom"
                            icon_color: "white"

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "4dp"
                        MDLabel:
                            text: "Favorite Songs"
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            halign: "center"
                            adaptive_height: True
                        MDLabel:
                            text: "Your Liked Collection"
                            font_style: "Title"
                            role: "medium"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primaryColor
                            adaptive_height: True
                        MDLabel:
                            text: "Auto-synced • 6 tracks • 21 min"
                            font_style: "Body"
                            role: "small"
                            halign: "center"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True

                    MDBoxLayout:
                        adaptive_size: True
                        spacing: "8dp"
                        pos_hint: {"center_x": .5}
                        MDButton:
                            style: "filled"
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDButtonIcon:
                                icon: "play"
                            MDButtonText:
                                text: "Play All"
                        MDButton:
                            style: "tonal"
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDButtonIcon:
                                icon: "shuffle"
                            MDButtonText:
                                text: "Shuffle"
                        MDIconButton:
                            style: "outlined"
                            icon: "download-outline"
                            pos_hint: {"center_y": .5}
                            on_release: app.download_active_playlist("Favorites")

                # Section Header: Tracks
                MDLabel:
                    text: "Tracks"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

                # Tracks List Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(20)]
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    md_bg_color: app.theme_cls.surfaceContainerLowColor

                    MDList:
                        id: favorites_track_list
                        MDListItem:
                            on_release: if len(app.playlist_model.tracks) > 0: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "heart"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#ff5252")
                            MDListItemHeadlineText:
                                text: "Angreji Beat"
                            MDListItemSupportingText:
                                text: "Yo Yo Honey Singh, Gippy Grewal • 3:30"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if len(app.playlist_model.tracks) > 1: app.play_selected_track(app.playlist_model.tracks[1])
                            MDListItemLeadingIcon:
                                icon: "heart"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#ff5252")
                            MDListItemHeadlineText:
                                text: "Dope Shope"
                            MDListItemSupportingText:
                                text: "Yo Yo Honey Singh, Deep Money • 3:09"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if len(app.playlist_model.tracks) > 2: app.play_selected_track(app.playlist_model.tracks[2])
                            MDListItemLeadingIcon:
                                icon: "heart"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#ff5252")
                            MDListItemHeadlineText:
                                text: "Brown Rang"
                            MDListItemSupportingText:
                                text: "Yo Yo Honey Singh • 2:59"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if len(app.playlist_model.tracks) > 0: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "heart"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#ff5252")
                            MDListItemHeadlineText:
                                text: "Blue Eyes"
                            MDListItemSupportingText:
                                text: "Yo Yo Honey Singh • 3:40"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if len(app.playlist_model.tracks) > 1: app.play_selected_track(app.playlist_model.tracks[1])
                            MDListItemLeadingIcon:
                                icon: "heart"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#ff5252")
                            MDListItemHeadlineText:
                                text: "Desi Kalakaar"
                            MDListItemSupportingText:
                                text: "Yo Yo Honey Singh • 4:18"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if len(app.playlist_model.tracks) > 2: app.play_selected_track(app.playlist_model.tracks[2])
                            MDListItemLeadingIcon:
                                icon: "heart"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#ff5252")
                            MDListItemHeadlineText:
                                text: "Love Dose"
                            MDListItemSupportingText:
                                text: "Yo Yo Honey Singh • 3:48"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"
