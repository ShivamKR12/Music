<ArtistScreen>:
    name: "artist"
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Artist Profile"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "share-variant-outline"
                    on_release: app.show_toast(f"Artist link for '{app.active_artist_name}' copied")

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "88dp"]
                spacing: "20dp"

                # Artist Header Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(24)]
                    padding: "20dp"
                    spacing: "14dp"
                    orientation: "vertical"
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    FitImage:
                        source: app.active_artist_art or "album_art.png"
                        size_hint: None, None
                        size: "130dp", "130dp"
                        radius: [dp(65)]
                        pos_hint: {"center_x": .5}

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "4dp"
                        MDLabel:
                            text: app.active_artist_name or "Artist"
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            halign: "center"
                            adaptive_height: True

                        MDBoxLayout:
                            adaptive_size: True
                            pos_hint: {"center_x": .5}
                            spacing: "6dp"
                            MDIcon:
                                icon: "check-decagram"
                                font_size: "16sp"
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primaryColor
                            MDLabel:
                                text: "Verified Artist"
                                font_style: "Label"
                                role: "medium"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primaryColor
                                adaptive_size: True

                        MDLabel:
                            text: app.active_artist_info or "Popular Tracks"
                            font_style: "Body"
                            role: "small"
                            halign: "center"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True

                    MDBoxLayout:
                        adaptive_size: True
                        spacing: "8dp"
                        pos_hint: {"center_x": .5}
                        MDButton:
                            style: "filled"
                            on_release: app.play_active_artist()
                            MDButtonIcon:
                                icon: "play"
                            MDButtonText:
                                text: "Play"
                        MDButton:
                            style: "tonal"
                            on_release: app.show_toast(f"Following {app.active_artist_name}")
                            MDButtonIcon:
                                icon: "heart-outline"
                            MDButtonText:
                                text: "Follow"
                        MDIconButton:
                            style: "outlined"
                            icon: "radio-tower"
                            pos_hint: {"center_y": .5}
                            on_release: app.show_toast(f"Starting {app.active_artist_name} Radio")

                # Section Header: Top Tracks
                MDLabel:
                    text: "Top Tracks"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

                # Real Dynamic Top Tracks
                EmbeddedRecycleView:
                    id: artist_tracks_list
                    viewclass: "TrackListItem"
                    size_hint_y: None
                    height: max(dp(72), (dp(72) + dp(16)) * len(self.data)) if self.data else 0
                    RecycleBoxLayout:
                        default_size: None, dp(72)
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height
                        orientation: 'vertical'
                        spacing: dp(16)

                # Section Header: Albums
                MDLabel:
                    text: "Discography & Albums"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

                # Horizontal Scrollable Albums list
                DirectionalHorizontalScrollView:
                    size_hint_y: None
                    height: "170dp"
                    do_scroll_y: False
                    do_scroll_x: True
                    bar_width: "2dp"
                    MDBoxLayout:
                        id: artist_albums_box
                        adaptive_size: True
                        height: "170dp"
                        spacing: "16dp"
                        padding: ["0dp", "4dp", "0dp", "4dp"]
