<BrowseScreen>
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                text: "Browse"
                
        MDScrollView:
            MDGridLayout:
                cols: 2
                adaptive_height: True
                padding: "16dp"
                spacing: "16dp"
                
                MDCard:
                    size_hint_y: None
                    height: "120dp"
                    MDLabel:
                        text: "New Releases"
                        halign: "center"
                        
                MDCard:
                    size_hint_y: None
                    height: "120dp"
                    MDLabel:
                        text: "Charts"
                        halign: "center"
