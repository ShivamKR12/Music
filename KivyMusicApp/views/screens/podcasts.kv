<PodcastsScreen>:
    name: "podcasts"
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Podcasts & Shows"

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "32dp"]
                spacing: "16dp"

                # Featured Spotlight Show Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(20)]
                    padding: "20dp"
                    spacing: "12dp"
                    orientation: "vertical"
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: "8dp"
                        MDIcon:
                            icon: "podcast"
                            font_size: "20sp"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primaryColor
                        MDLabel:
                            text: "FEATURED SHOW"
                            font_style: "Label"
                            role: "medium"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primaryColor
                            adaptive_height: True

                    MDLabel:
                        text: app.podcast_featured_title or "Trending Podcast"
                        font_style: "Headline"
                        role: "small"
                        bold: True
                        adaptive_height: True

                    MDLabel:
                        text: app.podcast_featured_desc or "Discover popular podcast episodes, shows, and conversations."
                        font_style: "Body"
                        role: "medium"
                        text_color: app.theme_cls.onSurfaceVariantColor
                        adaptive_height: True

                    MDBoxLayout:
                        adaptive_height: True
                        padding: ["0dp", "8dp", "0dp", "0dp"]
                        MDButton:
                            style: "filled"
                            on_release: app.play_featured_podcast()
                            MDButtonIcon:
                                icon: "play"
                            MDButtonText:
                                text: "Listen to Latest"

                # Section Header
                MDLabel:
                    text: "Trending Episodes"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

                # Real Dynamic Trending Episodes
                EmbeddedRecycleView:
                    id: podcasts_list
                    viewclass: "TrackListItem"
                    size_hint_y: None
                    height: max(dp(72), (dp(72) + dp(16)) * len(self.data)) if self.data else 0
                    RecycleBoxLayout:
                        default_size: None, dp(72)
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height
                        orientation: 'vertical'
                        spacing: dp(16)
