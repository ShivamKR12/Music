<PodcastsScreen>
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                text: "Podcasts"
                
        MDScrollView:
            MDList:
                MDListItem:
                    MDListItemLeadingIcon:
                        icon: "podcast"
                    MDListItemHeadlineText:
                        text: "Tech Talk"
                    MDListItemSupportingText:
                        text: "Latest episodes"
