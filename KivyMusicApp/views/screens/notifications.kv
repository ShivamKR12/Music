<NotificationScreen>:
    name: "notifications"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Notifications"
                
        MDScrollView:
            MDList:
                MDListItem:
                    on_release: app.switch_screen("album")
                    MDListItemLeadingIcon:
                        icon: "album"
                    MDListItemHeadlineText:
                        text: "New Release from Gippy Grewal"
                    MDListItemSupportingText:
                        text: "Check out the new album!"
                    MDListItemTertiaryText:
                        text: "2 hours ago"
                        
                MDListItem:
                    on_release: app.switch_screen("playlist")
                    MDListItemLeadingIcon:
                        icon: "playlist-star"
                    MDListItemHeadlineText:
                        text: "Your weekly mix is ready"
                    MDListItemSupportingText:
                        text: "Made just for you"
                    MDListItemTertiaryText:
                        text: "1 day ago"
                        
                MDListItem:
                    on_release: app.switch_screen("artist")
                    MDListItemLeadingIcon:
                        icon: "ticket-confirmation"
                    MDListItemHeadlineText:
                        text: "Concert near you"
                    MDListItemSupportingText:
                        text: "Yo Yo Honey Singh is playing in your city"
                    MDListItemTertiaryText:
                        text: "3 days ago"

