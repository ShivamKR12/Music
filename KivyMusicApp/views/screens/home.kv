<HomeScreen>:
    name: "home"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                text: app.get_greeting()
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "bell-outline"
                    on_release: app.switch_screen("notifications")
                MDActionTopAppBarButton:
                    icon: "history"
                    on_release: app.switch_screen("recently_played")
                MDActionTopAppBarButton:
                    icon: "cog-outline"
                    on_release: app.switch_screen("settings")
        
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "32dp"]
                spacing: "24dp"

                # Mood Chips
                DirectionalHorizontalScrollView:
                    size_hint_y: None
                    height: "48dp"
                    do_scroll_y: False
                    do_scroll_x: True
                    bar_width: "2dp"
                    MDBoxLayout:
                        id: mood_box
                        adaptive_size: True
                        height: "48dp"
                        padding: ["8dp", "8dp", "8dp", "8dp"]
                        spacing: "8dp"
                        MDChip:
                            type: "filter"
                            active: True
                            md_bg_color: app.theme_cls.primaryColor
                            on_release: app.select_mood_filter(self, "All")
                            MDChipText:
                                text: "All"
                                text_color: app.theme_cls.onPrimaryColor
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Relax")
                            MDChipText:
                                text: "Relax"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Workout")
                            MDChipText:
                                text: "Workout"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Focus")
                            MDChipText:
                                text: "Focus"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Energize")
                            MDChipText:
                                text: "Energize"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Commute")
                            MDChipText:
                                text: "Commute"

                MDLabel:
                    text: "Quick picks"
                    font_style: "Title"
                    role: "large"
                    adaptive_height: True

                DirectionalHorizontalRecycleView:
                    id: quick_picks_list
                    viewclass: "HomeCardItem"
                    size_hint_y: None
                    height: "172dp"
                    data: [{"text": f"Quick Pick {i}"} for i in range(1, 9)]
                    RecycleBoxLayout:
                        default_size: dp(140), dp(140)
                        default_size_hint: None, None
                        size_hint_x: None
                        width: self.minimum_width
                        orientation: 'horizontal'
                        spacing: dp(16)
                        padding: [dp(16), dp(16)]

                MDLabel:
                    text: "Trending community playlists"
                    font_style: "Title"
                    role: "large"
                    adaptive_height: True

                DirectionalHorizontalRecycleView:
                    id: trending_list
                    viewclass: "HomeCardItem"
                    size_hint_y: None
                    height: "172dp"
                    data: [{"text": f"Playlist {i}"} for i in range(10)]
                    RecycleBoxLayout:
                        default_size: dp(140), dp(140)
                        default_size_hint: None, None
                        size_hint_x: None
                        width: self.minimum_width
                        orientation: 'horizontal'
                        spacing: dp(16)
                        padding: [dp(16), dp(16)]

                MDLabel:
                    text: "Featured playlists for you"
                    font_style: "Title"
                    role: "large"
                    adaptive_height: True

                DirectionalHorizontalRecycleView:
                    id: featured_list
                    viewclass: "HomeCardItem"
                    size_hint_y: None
                    height: "172dp"
                    data: [{"text": f"Featured {i}"} for i in range(10)]
                    RecycleBoxLayout:
                        default_size: dp(140), dp(140)
                        default_size_hint: None, None
                        size_hint_x: None
                        width: self.minimum_width
                        orientation: 'horizontal'
                        spacing: dp(16)
                        padding: [dp(16), dp(16)]
