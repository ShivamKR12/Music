<WrappedScreen>:
    name: "wrapped"
    md_bg_color: "black" # A distinct, dark background for wrapped
    
    MDFloatLayout:
        Carousel:
            id: wrapped_carousel
            direction: "right"
            
            # Slide 1: Welcome
            MDBoxLayout:
                orientation: "vertical"
                padding: "24dp"
                spacing: "16dp"
                md_bg_color: get_color_from_hex("#1DB954")
                
                MDLabel:
                    text: "Your 2026 Wrapped"
                    font_style: "Display"
                    role: "large"
                    
                    text_color: "white"
                    halign: "center"
                    bold: True
                MDLabel:
                    text: "Swipe to begin."
                    font_style: "Title"
                    role: "medium"
                    
                    text_color: "white"
                    halign: "center"
                    
            # Slide 2: Top Artist
            MDBoxLayout:
                orientation: "vertical"
                padding: "24dp"
                spacing: "16dp"
                md_bg_color: get_color_from_hex("#FF4081")
                
                MDLabel:
                    text: "You couldn't get enough of..."
                    font_style: "Headline"
                    role: "medium"
                    
                    text_color: "white"
                    halign: "center"
                FitImage:
                    source: "album_art.png"
                    radius: [dp(24)]
                    size_hint_y: 0.6
                MDLabel:
                    text: "Gippy Grewal"
                    font_style: "Display"
                    role: "medium"
                    
                    text_color: "white"
                    halign: "center"
                    bold: True
                    
            # Slide 3: Top Song
            MDBoxLayout:
                orientation: "vertical"
                padding: "24dp"
                spacing: "16dp"
                md_bg_color: get_color_from_hex("#7E57C2")
                
                MDLabel:
                    text: "Your #1 Song was..."
                    font_style: "Headline"
                    role: "medium"
                    
                    text_color: "white"
                    halign: "center"
                MDLabel:
                    text: "Angreji Beat"
                    font_style: "Display"
                    role: "large"
                    
                    text_color: "white"
                    halign: "center"
                    bold: True
                MDLabel:
                    text: "Played 420 times"
                    font_style: "Title"
                    role: "large"
                    
                    text_color: "white"
                    halign: "center"

        # Floating Close Button
        MDIconButton:
            icon: "close"
            style: "standard"
            theme_icon_color: "Custom"
            icon_color: "white"
            pos_hint: {"top": 0.98, "x": 0.04}
            on_release: app.go_back()

