<SplashScreen>:
    name: "splash"
    md_bg_color: app.theme_cls.backgroundColor

    MDFloatLayout:
        # Ambient center logo and branding section
        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 0.85
            adaptive_height: True
            pos_hint: {"center_x": .5, "center_y": .54}
            spacing: "16dp"

            # App Logo Container with pulse animation
            MDCard:
                id: logo_card
                style: "filled"
                size_hint: None, None
                size: "108dp", "108dp"
                radius: [dp(54), dp(54), dp(54), dp(54)]
                pos_hint: {"center_x": .5}
                md_bg_color: app.theme_cls.primaryContainerColor

                MDRelativeLayout:
                    size_hint: 1, 1
                    MDIcon:
                        id: splash_icon
                        icon: "music-note"
                        pos_hint: {"center_x": .5, "center_y": .5}
                        theme_icon_color: "Custom"
                        icon_color: app.theme_cls.primaryColor
                        theme_font_size: "Custom"
                        font_size: "76sp"

            MDLabel:
                text: "Melodify"
                font_style: "Headline"
                role: "large"
                bold: True
                halign: "center"
                adaptive_height: True
                size_hint_x: 1

            MDLabel:
                text: "Your Personal Soundscape"
                font_style: "Body"
                role: "medium"
                halign: "center"
                adaptive_height: True
                size_hint_x: 1
                text_color: app.theme_cls.onSurfaceVariantColor

        # Bottom Progress & Dynamic Status Section
        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 0.72
            adaptive_height: True
            pos_hint: {"center_x": .5, "y": .12}
            spacing: "12dp"

            MDLinearProgressIndicator:
                id: splash_progress
                type: "determinate"
                value: 0
                max: 100
                size_hint_x: 1
                size_hint_y: None
                height: "6dp"
                indicator_color: app.theme_cls.primaryColor
                track_color: app.theme_cls.surfaceContainerHighestColor

            MDLabel:
                id: splash_status_label
                text: "Starting..."
                font_style: "Body"
                role: "small"
                halign: "center"
                adaptive_height: True
                text_color: app.theme_cls.onSurfaceVariantColor
                pos_hint: {"center_x": .5}
