<AlbumScreen>:
    name: "album"
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Album"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "heart-outline"
                    on_release: app.show_toast(f"Saved album '{app.active_album_name}' to Library")
                MDActionTopAppBarButton:
                    icon: "share-variant-outline"
                    on_release: app.show_toast(f"Share link for '{app.active_album_name}' copied")

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "88dp"]
                spacing: "20dp"

                # Album Header Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(24)]
                    padding: "20dp"
                    spacing: "16dp"
                    orientation: "vertical"
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    FitImage:
                        source: app.active_album_art if app.active_album_art else "album_art.png"
                        size_hint: None, None
                        size: "180dp", "180dp"
                        radius: [dp(16)]
                        pos_hint: {"center_x": .5}

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "4dp"
                        MDLabel:
                            text: app.active_album_name or "Album"
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            halign: "center"
                            adaptive_height: True
                        MDLabel:
                            text: app.active_album_artist or "Artist"
                            font_style: "Title"
                            role: "medium"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primaryColor
                            adaptive_height: True
                        MDLabel:
                            text: app.active_album_info or "Album Collection"
                            font_style: "Body"
                            role: "small"
                            halign: "center"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True

                    MDBoxLayout:
                        adaptive_size: True
                        spacing: "8dp"
                        pos_hint: {"center_x": .5}
                        MDButton:
                            style: "filled"
                            on_release: app.play_active_album(shuffle=False)
                            MDButtonIcon:
                                icon: "play"
                            MDButtonText:
                                text: "Play"
                        MDButton:
                            style: "tonal"
                            on_release: app.play_active_album(shuffle=True)
                            MDButtonIcon:
                                icon: "shuffle"
                            MDButtonText:
                                text: "Shuffle"
                        MDIconButton:
                            style: "outlined"
                            icon: "download-outline"
                            pos_hint: {"center_y": .5}
                            on_release: app.download_active_playlist()

                # Section Header
                MDLabel:
                    text: "Tracklist"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

                MDLabel:
                    text: "Loading tracks from YouTube..." if app.album_loading else ""
                    font_style: "Body"
                    role: "small"
                    adaptive_height: True
                    opacity: 1 if app.album_loading else 0
                    height: "20dp" if app.album_loading else 0
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.onSurfaceVariantColor

                # Real Dynamic Tracklist
                EmbeddedRecycleView:
                    id: album_tracks_list
                    viewclass: "TrackListItem"
                    size_hint_y: None
                    height: max(dp(72), (dp(72) + dp(16)) * len(self.data)) if self.data else 0
                    RecycleBoxLayout:
                        default_size: None, dp(72)
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height
                        orientation: 'vertical'
                        spacing: dp(16)
