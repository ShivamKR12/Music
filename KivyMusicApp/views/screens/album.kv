<AlbumScreen>:
    name: "album"
    md_bg_color: app.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Album"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "heart-outline"
                MDActionTopAppBarButton:
                    icon: "share-variant-outline"

        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "16dp", "16dp", "32dp"]
                spacing: "20dp"

                # Album Header Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(24)]
                    padding: "20dp"
                    spacing: "16dp"
                    orientation: "vertical"
                    md_bg_color: app.theme_cls.surfaceContainerColor

                    FitImage:
                        source: "album_art.png"
                        size_hint: None, None
                        size: "180dp", "180dp"
                        radius: [dp(16)]
                        pos_hint: {"center_x": .5}

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: "4dp"
                        MDLabel:
                            text: "Future Echoes"
                            font_style: "Headline"
                            role: "small"
                            bold: True
                            halign: "center"
                            adaptive_height: True
                        MDLabel:
                            text: "Synthwave Collective"
                            font_style: "Title"
                            role: "medium"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primaryColor
                            adaptive_height: True
                        MDLabel:
                            text: "Album • 2024 • 6 tracks • 24 min"
                            font_style: "Body"
                            role: "small"
                            halign: "center"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            adaptive_height: True

                    MDBoxLayout:
                        adaptive_size: True
                        spacing: "8dp"
                        pos_hint: {"center_x": .5}
                        MDButton:
                            style: "filled"
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDButtonIcon:
                                icon: "play"
                            MDButtonText:
                                text: "Play"
                        MDButton:
                            style: "tonal"
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDButtonIcon:
                                icon: "shuffle"
                            MDButtonText:
                                text: "Shuffle"
                        MDIconButton:
                            style: "outlined"
                            icon: "download-outline"
                            pos_hint: {"center_y": .5}

                # Section Header
                MDLabel:
                    text: "Tracklist"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

                # Tracks List Card
                MDCard:
                    style: "elevated"
                    size_hint_y: None
                    adaptive_height: True
                    radius: [dp(20)]
                    padding: ["0dp", "8dp", "0dp", "8dp"]
                    md_bg_color: app.theme_cls.surfaceContainerLowColor

                    MDList:
                        MDListItem:
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "numeric-1-circle-outline"
                            MDListItemHeadlineText:
                                text: "Midnight City Lights"
                            MDListItemSupportingText:
                                text: "Synthwave Collective • 3:42"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "numeric-2-circle-outline"
                            MDListItemHeadlineText:
                                text: "Neon Horizon"
                            MDListItemSupportingText:
                                text: "Synthwave Collective • 4:15"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "numeric-3-circle-outline"
                            MDListItemHeadlineText:
                                text: "Digital Sunset"
                            MDListItemSupportingText:
                                text: "Synthwave Collective • 3:18"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "numeric-4-circle-outline"
                            MDListItemHeadlineText:
                                text: "Quantum Pulse"
                            MDListItemSupportingText:
                                text: "Synthwave Collective • 5:01"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "numeric-5-circle-outline"
                            MDListItemHeadlineText:
                                text: "Retrograde"
                            MDListItemSupportingText:
                                text: "Synthwave Collective • 3:55"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"

                        MDListItem:
                            on_release: if app.playlist_model.tracks: app.play_selected_track(app.playlist_model.tracks[0])
                            MDListItemLeadingIcon:
                                icon: "numeric-6-circle-outline"
                            MDListItemHeadlineText:
                                text: "Cybernetic Drift"
                            MDListItemSupportingText:
                                text: "Synthwave Collective • 4:30"
                            MDListItemTrailingIcon:
                                icon: "dots-vertical"
