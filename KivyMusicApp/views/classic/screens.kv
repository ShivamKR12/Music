# Classic (pre-SimpMusic) screen rules.
# Loaded/unloaded at runtime by MusicApp when the user switches interface style.
# These are the original versions from git HEAD; the only intentional edit is the
# "Interface Style" toggle row added to the classic settings screen.

<LibraryGridCard@MDCard>:
    style: "elevated"
    radius: [dp(16)]
    ripple_behavior: True
    padding: "16dp"
    spacing: "8dp"
    orientation: "vertical"
    icon: "music"
    text: "Title"
    text_color: app.theme_cls.onSurfaceColor
    icon_color: app.theme_cls.primaryColor
    MDIcon:
        icon: root.icon
        text_color: root.icon_color
        font_size: "32sp"
    MDLabel:
        text: root.text
        font_style: "Title"
        role: "medium"
        text_color: root.text_color
        bold: True



# ===== classic home.kv =====
<HomeScreen>:
    name: "home"
    md_bg_color: app.theme_cls.backgroundColor
    MDFloatLayout:
        MDScrollView:
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["16dp", "72dp", "16dp", "32dp"]
                spacing: "24dp"

                # Mood Chips
                DirectionalHorizontalScrollView:
                    size_hint_y: None
                    height: "48dp"
                    do_scroll_y: False
                    do_scroll_x: True
                    bar_width: "2dp"
                    MDBoxLayout:
                        id: mood_box
                        adaptive_size: True
                        height: "48dp"
                        padding: ["8dp", "8dp", "8dp", "8dp"]
                        spacing: "8dp"
                        MDChip:
                            type: "filter"
                            active: True
                            md_bg_color: app.theme_cls.primaryColor
                            on_release: app.select_mood_filter(self, "All")
                            MDChipText:
                                text: "All"
                                text_color: app.theme_cls.onPrimaryColor
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Relax")
                            MDChipText:
                                text: "Relax"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Workout")
                            MDChipText:
                                text: "Workout"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Focus")
                            MDChipText:
                                text: "Focus"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Energize")
                            MDChipText:
                                text: "Energize"
                        MDChip:
                            type: "filter"
                            on_release: app.select_mood_filter(self, "Commute")
                            MDChipText:
                                text: "Commute"

                MDLabel:
                    text: "Quick picks"
                    font_style: "Title"
                    role: "large"
                    adaptive_height: True

                DirectionalHorizontalRecycleView:
                    id: quick_picks_list
                    viewclass: "HomeCardItem"
                    size_hint_y: None
                    height: "238dp"
                    data: []
                    RecycleBoxLayout:
                        default_size: dp(140), dp(210)
                        default_size_hint: None, None
                        size_hint_x: None
                        width: self.minimum_width
                        orientation: 'horizontal'
                        spacing: dp(16)
                        padding: [dp(16), dp(12)]

                MDLabel:
                    text: "Trending community playlists"
                    font_style: "Title"
                    role: "large"
                    adaptive_height: True

                DirectionalHorizontalRecycleView:
                    id: trending_list
                    viewclass: "HomeCardItem"
                    size_hint_y: None
                    height: "238dp"
                    data: []
                    RecycleBoxLayout:
                        default_size: dp(140), dp(210)
                        default_size_hint: None, None
                        size_hint_x: None
                        width: self.minimum_width
                        orientation: 'horizontal'
                        spacing: dp(16)
                        padding: [dp(16), dp(12)]

                MDLabel:
                    text: "Featured playlists for you"
                    font_style: "Title"
                    role: "large"
                    adaptive_height: True

                DirectionalHorizontalRecycleView:
                    id: featured_list
                    viewclass: "HomeCardItem"
                    size_hint_y: None
                    height: "238dp"
                    data: []
                    RecycleBoxLayout:
                        default_size: dp(140), dp(210)
                        default_size_hint: None, None
                        size_hint_x: None
                        width: self.minimum_width
                        orientation: 'horizontal'
                        spacing: dp(16)
                        padding: [dp(16), dp(12)]

        MDTopAppBar:
            type: "small"
            pos_hint: {"top": 1, "x": 0}
            size_hint_y: None
            height: "64dp"
            md_bg_color: app.theme_cls.backgroundColor
            MDTopAppBarTitle:
                text: app.get_greeting()
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "bell-outline"
                    on_release: app.switch_screen("notifications")
                MDActionTopAppBarButton:
                    icon: "history"
                    on_release: app.switch_screen("recently_played")
                MDActionTopAppBarButton:
                    icon: "cog-outline"
                    on_release: app.switch_screen("settings")


# ===== classic search.kv =====
<SearchScreen>:
    name: "search"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Search"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "spotify"
                    on_release: app.show_import_spotify_dialog()
                
        MDBoxLayout:
            orientation: "vertical"
            padding: ["16dp", "16dp", "16dp", "24dp"]
            spacing: "16dp"
            
            MDBoxLayout:
                adaptive_height: True
                spacing: "8dp"
                MDTextField:
                    id: search_input
                    mode: "outlined"
                    size_hint_x: 1
                    on_text_validate: app.perform_search(self.text)
                    MDTextFieldHintText:
                        text: "Search songs, artists, podcasts..."
                    MDTextFieldLeadingIcon:
                        icon: "magnify"
                MDIconButton:
                    id: search_clear_btn
                    icon: "close"
                    style: "standard"
                    pos_hint: {"center_y": .5}
                    opacity: 1 if search_input.text else 0
                    disabled: False if search_input.text else True
                    on_release: app.clear_search_input()

            # Multi-Source Provider Filter Chips
            DirectionalHorizontalScrollView:
                size_hint_y: None
                height: "48dp"
                do_scroll_y: False
                do_scroll_x: True
                bar_width: "2dp"
                MDBoxLayout:
                    adaptive_size: True
                    height: "48dp"
                    padding: ["8dp", "8dp", "8dp", "8dp"]
                    spacing: "8dp"
                    MDChip:
                        type: "suggestion"
                        on_release: app.set_search_provider("all")
                        MDChipText:
                            text: "All Sources"
                    MDChip:
                        type: "suggestion"
                        on_release: app.set_search_provider("jiosaavn")
                        MDChipLeadingIcon:
                            icon: "flash"
                        MDChipText:
                            text: "JioSaavn (320k HD)"
                    MDChip:
                        type: "suggestion"
                        on_release: app.set_search_provider("youtube")
                        MDChipLeadingIcon:
                            icon: "youtube"
                        MDChipText:
                            text: "YouTube"
                    MDChip:
                        type: "suggestion"
                        on_release: app.set_search_provider("spotify")
                        MDChipLeadingIcon:
                            icon: "spotify"
                        MDChipText:
                            text: "Spotify"

            # Browse Category Chips
            DirectionalHorizontalScrollView:
                size_hint_y: None
                height: "48dp"
                do_scroll_y: False
                do_scroll_x: True
                bar_width: "2dp"
                MDBoxLayout:
                    adaptive_size: True
                    height: "48dp"
                    padding: ["8dp", "8dp", "8dp", "8dp"]
                    spacing: "8dp"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Pop"; app.perform_search("Pop")
                        MDChipText:
                            text: "Pop"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Hip-Hop"; app.perform_search("Hip-Hop")
                        MDChipText:
                            text: "Hip-Hop"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Rock"; app.perform_search("Rock")
                        MDChipText:
                            text: "Rock"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Bollywood"; app.perform_search("Bollywood")
                        MDChipText:
                            text: "Bollywood"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Punjabi"; app.perform_search("Punjabi")
                        MDChipText:
                            text: "Punjabi"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Indie"; app.perform_search("Indie")
                        MDChipText:
                            text: "Indie"
                    MDChip:
                        type: "suggestion"
                        on_release: search_input.text = "Podcasts"; app.perform_search("Podcasts")
                        MDChipText:
                            text: "Podcasts"

            # Results Section Header
            MDBoxLayout:
                id: results_header_box
                adaptive_height: True
                opacity: 1 if search_results_list.data else 0
                height: self.minimum_height if search_results_list.data else 0
                MDLabel:
                    id: search_status_label
                    text: "Search Results"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True

            # Results List
            RecycleView:
                id: search_results_list
                viewclass: "TrackListItem"
                data: []
                size_hint_y: 1 if self.data else None
                height: dp(260) if self.data else 0
                opacity: 1 if self.data else 0
                RecycleBoxLayout:
                    default_size: None, dp(64)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(8)

            MDBoxLayout:
                id: history_header_box
                adaptive_height: True
                opacity: 1 if not search_results_list.data else 0
                height: self.minimum_height if not search_results_list.data else 0
                MDLabel:
                    text: "Recent searches"
                    font_style: "Title"
                    role: "medium"
                    bold: True
                    adaptive_height: True
                MDButton:
                    style: "text"
                    on_release: app.clear_search_history()
                    MDButtonText:
                        text: "Clear search history"
                        
            RecycleView:
                id: search_history_list
                viewclass: "SearchHistoryItem"
                data: [{"text": "unstoppable"}, {"text": "haryanvi songs"}]
                size_hint_y: 1 if not search_results_list.data else None
                height: dp(200) if not search_results_list.data else 0
                opacity: 1 if not search_results_list.data else 0
                RecycleBoxLayout:
                    default_size: None, dp(56)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(8)


# ===== classic library.kv =====
#:import get_color_from_hex kivy.utils.get_color_from_hex

<LibraryScreen>:
    name: "library"
    md_bg_color: app.theme_cls.backgroundColor
    
    MDFloatLayout:
        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}
        
            MDTopAppBar:
                type: "small"
                MDTopAppBarTitle:
                    text: "Library"
                    font_style: "Headline"
                    role: "large"
                MDTopAppBarTrailingButtonContainer:
                    MDActionTopAppBarButton:
                        icon: "plus-circle-outline"
                        on_release: app.show_add_playlist_dialog()

            MDScrollView:
                id: library_scroll
                do_scroll_x: False
                do_scroll_y: True
                MDBoxLayout:
                    orientation: "vertical"
                    padding: ["16dp", "16dp", "16dp", "88dp"]
                    spacing: "24dp"
                    adaptive_height: True

                    # Library Filter Chips
                    DirectionalHorizontalScrollView:
                        size_hint_y: None
                        height: "48dp"
                        do_scroll_y: False
                        do_scroll_x: True
                        bar_width: "2dp"
                        MDBoxLayout:
                            id: library_chips_box
                            adaptive_size: True
                            height: "48dp"
                            padding: ["8dp", "8dp", "8dp", "8dp"]
                            spacing: "8dp"
                            MDChip:
                                type: "filter"
                                active: True
                                md_bg_color: app.theme_cls.primaryColor
                                on_release: app.select_library_filter(self, "Playlists")
                                MDChipText:
                                    text: "Playlists"
                                    text_color: app.theme_cls.onPrimaryColor
                            MDChip:
                                type: "filter"
                                on_release: app.select_library_filter(self, "Songs")
                                MDChipText:
                                    text: "Songs"
                            MDChip:
                                type: "filter"
                                on_release: app.select_library_filter(self, "Albums")
                                MDChipText:
                                    text: "Albums"
                            MDChip:
                                type: "filter"
                                on_release: app.select_library_filter(self, "Artists")
                                MDChipText:
                                    text: "Artists"
                            MDChip:
                                type: "filter"
                                on_release: app.select_library_filter(self, "Downloaded")
                                MDChipText:
                                    text: "Downloaded"

                    # 2x3 Custom Grid
                    MDGridLayout:
                        cols: 2
                        adaptive_height: True
                        spacing: "16dp"
                        row_default_height: "80dp"
                        row_force_default: True
                        
                        LibraryGridCard:
                            icon: "heart"
                            text: "Favorite"
                            md_bg_color: get_color_from_hex("#ff5252")
                            text_color: "white"
                            icon_color: "white"
                            on_release: app.show_favorites()
                        LibraryGridCard:
                            icon: "account-multiple"
                            text: "Followed"
                            md_bg_color: get_color_from_hex("#ffd740")
                            on_release: app.switch_screen("artist")
                        LibraryGridCard:
                            icon: "play-circle-outline"
                            text: "Most Played"
                            md_bg_color: get_color_from_hex("#18ffff")
                            on_release: app.switch_screen("recently_played")
                        LibraryGridCard:
                            icon: "download"
                            text: "Downloaded"
                            md_bg_color: get_color_from_hex("#69f0ae")
                            on_release: app.show_downloaded()
                        LibraryGridCard:
                            icon: "chart-bar"
                            text: "Analytics"
                            md_bg_color: get_color_from_hex("#b388ff")
                            on_release: app.switch_screen("analytics")
                        LibraryGridCard:
                            icon: "star-shooting"
                            text: "Wrapped 2026"
                            md_bg_color: get_color_from_hex("#ff4081")
                            text_color: "white"
                            icon_color: "white"
                            on_release: app.switch_screen("wrapped")
                        LibraryGridCard:
                            icon: "account-music"
                            text: "Artists"
                            on_release: app.open_artist()
                        LibraryGridCard:
                            icon: "album"
                            text: "Albums"
                            on_release: app.open_album()
                        LibraryGridCard:
                            icon: "playlist-music"
                            text: "Playlists"
                            on_release: app.show_playlists_overview()
                        LibraryGridCard:
                            icon: "podcast"
                            text: "Podcasts"
                            on_release: app.open_podcasts()
                        LibraryGridCard:
                            icon: "compass"
                            text: "Browse"
                            on_release: app.switch_screen("browse")
                        LibraryGridCard:
                            icon: "emoticon-happy-outline"
                            text: "Moods"
                            on_release: app.switch_screen("mood")
                        LibraryGridCard:
                            icon: "equalizer"
                            text: "Equalizer"
                            on_release: app.switch_screen("equalizer")
                        LibraryGridCard:
                            icon: "account-group"
                            text: "Listen Together"
                            on_release: app.switch_screen("listen_together")
                        LibraryGridCard:
                            icon: "login"
                            text: "Auth/Login"
                            on_release: app.switch_screen("auth")

                    MDLabel:
                        text: "Recently Added"
                        font_style: "Title"
                        role: "large"
                        adaptive_height: True

                    EmbeddedRecycleView:
                        id: library_list
                        viewclass: "TrackListItem"
                        size_hint_y: None
                        height: dp(72) * len(self.data) + dp(16) * len(self.data)
                        RecycleBoxLayout:
                            default_size: None, dp(72)
                            default_size_hint: 1, None
                            size_hint_y: None
                            height: self.minimum_height
                            orientation: 'vertical'
                            spacing: dp(16)

        # Material 3 Floating Action Button to Import Local Audio Files
        MDFabButton:
            icon: "folder-music"
            style: "standard"
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryColor if app.theme_cls.primaryColor != [1, 1, 1, 1] else get_color_from_hex("#6750A4")
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.onPrimaryColor if app.theme_cls.onPrimaryColor != [1, 1, 1, 1] else get_color_from_hex("#ffffff")
            pos_hint: {"right": 0.94, "y": 0.05}
            on_release: app.show_local_audio_options()


# ===== classic settings.kv =====
<SettingsScreen>:
    name: "settings"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            type: "small"
            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.go_back()
            MDTopAppBarTitle:
                text: "Settings"
                
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: ["24dp", "24dp", "24dp", "48dp"]
                spacing: "24dp"

                MDList:
                    MDListItem:
                        on_release: app.toggle_ui_mode()
                        MDListItemHeadlineText:
                            text: "Interface Style"
                        MDListItemSupportingText:
                            text: "New look" if app.ui_mode == "new" else "Classic look"
                        PassiveTrailingCheckbox:
                            active: app.ui_mode == "new"

                    MDListItem:
                        on_release: app.show_audio_quality_dialog()
                        MDListItemHeadlineText:
                            text: "Audio Quality"
                        MDListItemSupportingText:
                            text: app.selected_audio_quality
                        MDListItemTrailingIcon:
                            icon: "chevron-right"
                            
                    MDListItem:
                        on_release: app.toggle_wifi_only()
                        MDListItemHeadlineText:
                            text: "Download over Wi-Fi only"
                        MDListItemSupportingText:
                            text: "Save mobile data"
                        PassiveTrailingCheckbox:
                            id: wifi_checkbox
                            active: app.wifi_only

                    MDListItem:
                        on_release: app.toggle_dark_mode()
                        MDListItemHeadlineText:
                            text: "Dark Mode"
                        MDListItemSupportingText:
                            text: "Toggle app theme"
                        PassiveTrailingCheckbox:
                            id: dark_checkbox
                            active: app.theme_cls.theme_style == "Dark"

                    MDListItem:
                        on_release: app.toggle_extract_artwork_colors()
                        MDListItemHeadlineText:
                            text: "Dynamic Artwork Theming"
                        MDListItemSupportingText:
                            text: "Extract Material You colors from track art"
                        PassiveTrailingCheckbox:
                            id: color_extract_checkbox
                            active: app.extract_artwork_colors

                    MDListItem:
                        on_release: app.toggle_animated_bg()
                        MDListItemHeadlineText:
                            text: "Animated Background"
                        MDListItemSupportingText:
                            text: "Dynamic flowing visual backdrop in player"
                        PassiveTrailingCheckbox:
                            id: anim_bg_checkbox
                            active: app.animated_bg_enabled

                    MDListItem:
                        on_release: app.show_animated_bg_style_dialog()
                        disabled: not app.animated_bg_enabled
                        MDListItemHeadlineText:
                            text: "Animation Style"
                        MDListItemSupportingText:
                            text: app.animated_bg_variation_label
                        MDListItemTrailingIcon:
                            icon: "palette-outline"

                    MDListItem:
                        on_release: app.cycle_animated_bg_speed()
                        disabled: not app.animated_bg_enabled
                        MDListItemHeadlineText:
                            text: "Animation Speed"
                        MDListItemSupportingText:
                            text: app.animated_bg_speed_label
                        MDListItemTrailingIcon:
                            icon: "speedometer"
                            
                    MDListItem:
                        on_release: app.toggle_sponsorblock()
                        MDListItemHeadlineText:
                            text: "SponsorBlock"
                        MDListItemSupportingText:
                            text: "Skip non-music segments"
                        PassiveTrailingCheckbox:
                            id: sponsor_checkbox
                            active: app.sponsorblock_enabled
                            
                    MDListItem:
                        on_release: app.switch_screen("equalizer")
                        MDListItemHeadlineText:
                            text: "Equalizer"
                        MDListItemSupportingText:
                            text: "Adjust audio frequencies"
                        MDListItemTrailingIcon:
                            icon: "chevron-right"
                            
                    MDListItem:
                        on_release: app.show_crossfade_dialog()
                        MDListItemHeadlineText:
                            text: "Audio Crossfade"
                        MDListItemSupportingText:
                            text: f"{int(app.crossfade_duration)}s transition" if app.crossfade_duration > 0 else "Off (Gapless)"
                        MDListItemTrailingIcon:
                            icon: "swap-horizontal"

                    MDListItem:
                        on_release: app.toggle_discord_rpc()
                        MDListItemHeadlineText:
                            text: "Discord Rich Presence"
                        MDListItemSupportingText:
                            text: "Broadcast song to Discord (Desktop)"
                        PassiveTrailingCheckbox:
                            id: discord_checkbox
                            active: app.discord_rpc_enabled

                    MDListItem:
                        on_release: app.show_clear_cache_dialog()
                        MDListItemHeadlineText:
                            text: "Clear Cache"
                        MDListItemSupportingText:
                            text: "Free up storage space"
                        MDListItemTrailingIcon:
                            icon: "delete-outline"

                    MDListItem:
                        on_release: app.smooth_exit()
                        MDListItemHeadlineText:
                            text: "Exit Application"
                        MDListItemSupportingText:
                            text: "Smoothly close Melodify"
                        MDListItemTrailingIcon:
                            icon: "power"

