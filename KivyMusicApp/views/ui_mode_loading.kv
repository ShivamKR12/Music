# Interface-style switch loading overlay (always loaded; unique rule name).
<UIModeLoadingOverlay@MDBoxLayout>:
    orientation: "vertical"
    md_bg_color: app.theme_cls.backgroundColor
    disabled: False

    MDBoxLayout:
        size_hint_y: 1

    MDCard:
        style: "filled"
        theme_bg_color: "Custom"
        md_bg_color: app.theme_cls.surfaceContainerLowColor
        radius: [dp(28)]
        padding: ["28dp", "24dp", "28dp", "24dp"]
        size_hint: None, None
        size: "272dp", "196dp"
        pos_hint: {"center_x": .5}
        orientation: "vertical"
        spacing: "12dp"

        MDIcon:
            icon: "theme-light-dark"
            theme_icon_color: "Custom"
            icon_color: app.theme_cls.primaryColor
            font_size: "40sp"
            halign: "center"
            size_hint: 1, None
            height: "48dp"

        MDLabel:
            id: ui_loading_title
            text: "Switching look..."
            font_style: "Title"
            role: "medium"
            bold: True
            halign: "center"
            adaptive_height: True

        MDLabel:
            id: ui_loading_detail
            text: "Applying the new interface"
            font_style: "Body"
            role: "small"
            halign: "center"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: app.theme_cls.onSurfaceVariantColor

        MDLinearProgressIndicator:
            type: "indeterminate"
            size_hint_x: 1
            size_hint_y: None
            height: "6dp"
            indicator_color: app.theme_cls.primaryColor
            track_color: app.theme_cls.surfaceContainerHighestColor

    MDBoxLayout:
        size_hint_y: 1
