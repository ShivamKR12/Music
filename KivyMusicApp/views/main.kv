#:import get_color_from_hex kivy.utils.get_color_from_hex

#:include views/screens/splash.kv
#:include views/screens/home.kv
#:include views/screens/search.kv
#:include views/screens/library.kv
#:include views/screens/settings.kv
#:include views/screens/player.kv
#:include views/screens/analytics.kv
#:include views/screens/wrapped.kv
#:include views/screens/notifications.kv
#:include views/screens/recently_played.kv
#:include views/screens/album.kv
#:include views/screens/artist.kv
#:include views/screens/playlist.kv
#:include views/screens/browse.kv
#:include views/screens/podcasts.kv
#:include views/screens/mood.kv
#:include views/screens/equalizer.kv
#:include views/screens/listen_together.kv
#:include views/screens/auth.kv
#:include views/screens/favorites.kv
#:include views/screens/lyrics.kv

<FitImage>:
    mipmap: True

<Image>:
    mipmap: True

<AsyncImage>:
    mipmap: True

<MDScreen>:
    pos_hint: {"x": 0, "y": 0}

<NavBarItem@MDNavigationItem>:
    icon: ""
    text: ""
    MDNavigationItemIcon:
        icon: root.icon
    MDNavigationItemLabel:
        text: root.text

MDBoxLayout:
    orientation: "vertical"
    md_bg_color: app.theme_cls.backgroundColor

    LazyScreenManager:
        id: screen_manager
        current: "splash"
        transition: __import__('kivy.uix.screenmanager').uix.screenmanager.SlideTransition(duration=0.18)

        SplashScreen:
        HomeScreen:
        SearchScreen:
        LibraryScreen:

    # Global Mini Player (Mobile Only - Floating Capsule Pill)
    MDBoxLayout:
        id: mini_player
        size_hint_y: None
        padding: ["12dp", "0dp", "12dp", "8dp"] if (app.mini_player_visible and app.player_controller and app.player_controller.active_track and screen_manager.current in ["home", "search", "library", "album", "artist", "playlist", "browse", "podcasts", "mood", "equalizer", "listen_together", "favorites"]) else ["0dp", "0dp", "0dp", "0dp"]
        opacity: 1 if (app.mini_player_visible and app.player_controller and app.player_controller.active_track and screen_manager.current in ["home", "search", "library", "album", "artist", "playlist", "browse", "podcasts", "mood", "equalizer", "listen_together", "favorites"]) else 0
        height: dp(72) if (app.mini_player_visible and app.player_controller and app.player_controller.active_track and screen_manager.current in ["home", "search", "library", "album", "artist", "playlist", "browse", "podcasts", "mood", "equalizer", "listen_together", "favorites"]) else 0
        disabled: False if (app.mini_player_visible and app.player_controller and app.player_controller.active_track and screen_manager.current in ["home", "search", "library", "album", "artist", "playlist", "browse", "podcasts", "mood", "equalizer", "listen_together", "favorites"]) else True
        MiniPlayerCard:
            style: "elevated"
            size_hint_y: None
            height: "64dp"
            md_bg_color: app.theme_cls.surfaceContainerHighestColor
            on_release: app.switch_screen("player")
            radius: [dp(24)]
            ripple_behavior: True
            MDBoxLayout:
                orientation: "vertical"
                size_hint: 1, 1

                MDBoxLayout:
                    padding: ["10dp", "4dp", "10dp", "4dp"]
                    spacing: "12dp"
                    size_hint_y: 1

                    FitImage:
                        source: app.player_controller.active_track.album_art if app.player_controller.active_track and app.player_controller.active_track.album_art else "album_art.png"
                        size_hint: None, None
                        size: "46dp", "46dp"
                        radius: [dp(23)]
                        mipmap: True
                        pos_hint: {"center_y": .5}

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_x: 1
                        pos_hint: {"center_y": .5}
                        spacing: "2dp"

                        MarqueeLabel:
                            text: app.player_controller.active_track.title if app.player_controller.active_track else "No Track"
                            font_style: "Body"
                            role: "medium"
                            bold: True
                            height: "20dp"
                            touch_pass_through: True

                        MarqueeLabel:
                            text: (("320k • " if getattr(app.player_controller.active_track, "source", "") == "jiosaavn" else ("Spotify • " if getattr(app.player_controller.active_track, "source", "") == "spotify" else "")) + app.player_controller.active_track.artist) if app.player_controller.active_track else "Unknown"
                            font_style: "Body"
                            role: "small"
                            text_color: app.theme_cls.onSurfaceVariantColor
                            height: "16dp"
                            touch_pass_through: True

                    MDIconButton:
                        icon: "heart" if app.player_controller.is_favorite else "heart-outline"
                        theme_icon_color: "Custom" if app.player_controller.is_favorite else "Primary"
                        icon_color: get_color_from_hex("#FF4081") if app.player_controller.is_favorite else app.theme_cls.onSurfaceVariantColor
                        pos_hint: {"center_y": .5}
                        on_release: app.player_controller.toggle_favorite()

                    MDFloatLayout:
                        size_hint: None, None
                        size: "42dp", "42dp"
                        pos_hint: {"center_y": .5}

                        MDIconButton:
                            id: mini_play_btn
                            icon: "pause" if app.player_controller.is_playing else "play"
                            style: "filled"
                            theme_bg_color: "Custom"
                            md_bg_color: app.theme_cls.primaryColor
                            theme_icon_color: "Custom"
                            icon_color: app.theme_cls.onPrimaryColor
                            size_hint: None, None
                            size: "42dp", "42dp"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            opacity: 0 if (app.player_controller and app.player_controller.is_loading) else 1
                            disabled: bool(app.player_controller and app.player_controller.is_loading)
                            on_release: app.player_controller.toggle_play()

                        YouTubeLoadingCircle:
                            size_hint: None, None
                            size: "30dp", "30dp"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            active: bool(app.player_controller and app.player_controller.is_loading)
                            opacity: 1 if (app.player_controller and app.player_controller.is_loading) else 0
                            color: app.theme_cls.primaryColor
                            line_width: dp(2.8)

                MDBoxLayout:
                    size_hint_y: None
                    height: "5dp"
                    padding: ["22dp", "0dp", "22dp", "3dp"]

                    MDLinearProgressIndicator:
                        id: mini_progress_bar
                        size_hint_y: None
                        height: "2dp"
                        radius: [dp(1)] if self.value_normalized > 0.01 else [0]
                        value: (app.player_controller.current_time / app.player_controller.duration * 100) if (app.player_controller and app.player_controller.duration > 0) else 0
                        indicator_color: app.theme_cls.primaryColor
                        track_color: app.theme_cls.outlineVariantColor[:-1] + [0.30]

    MDNavigationBar:
        id: bottom_nav
        on_switch_tabs: app.on_switch_tabs(*args)
        size_hint_y: None
        opacity: 1 if screen_manager.current in ["home", "search", "library"] else 0
        height: dp(80) if screen_manager.current in ["home", "search", "library"] else 0
        disabled: False if screen_manager.current in ["home", "search", "library"] else True

        NavBarItem:
            icon: "home"
            text: "Home"
            active: True

        NavBarItem:
            icon: "magnify"
            text: "Search"

        NavBarItem:
            icon: "music-box-multiple"
            text: "Library"
