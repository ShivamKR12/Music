#:import get_color_from_hex kivy.utils.get_color_from_hex

#:include views/screens/home.kv
#:include views/screens/search.kv
#:include views/screens/library.kv
#:include views/screens/settings.kv
#:include views/screens/player.kv
#:include views/screens/analytics.kv
#:include views/screens/wrapped.kv
#:include views/screens/notifications.kv
#:include views/screens/recently_played.kv
#:include views/screens/album.kv
#:include views/screens/artist.kv
#:include views/screens/playlist.kv
#:include views/screens/browse.kv
#:include views/screens/podcasts.kv
#:include views/screens/mood.kv
#:include views/screens/equalizer.kv
#:include views/screens/listen_together.kv
#:include views/screens/auth.kv
#:include views/screens/favorites.kv



<MDScreen>:
    pos_hint: {"x": 0, "y": 0}

<NavBarItem@MDNavigationItem>:
    icon: ""
    text: ""
    MDNavigationItemIcon:
        icon: root.icon
    MDNavigationItemLabel:
        text: root.text

<LibraryGridCard@MDCard>:
    style: "elevated"
    radius: [dp(16)]
    ripple_behavior: True
    padding: "16dp"
    spacing: "8dp"
    orientation: "vertical"
    icon: "music"
    text: "Title"
    text_color: app.theme_cls.onSurfaceColor
    icon_color: app.theme_cls.primaryColor
    MDIcon:
        icon: root.icon
        
        text_color: root.icon_color
        font_size: "32sp"
    MDLabel:
        text: root.text
        font_style: "Title"
        role: "medium"
        
        text_color: root.text_color
        bold: True

MDBoxLayout:
    orientation: "vertical"
    md_bg_color: app.theme_cls.backgroundColor

    MDScreenManager:
        id: screen_manager
        transition: __import__('kivy.uix.screenmanager').uix.screenmanager.FadeTransition()

        HomeScreen:
        SearchScreen:
        LibraryScreen:
        SettingsScreen:
        PlayerScreen:
        AnalyticsScreen:
        WrappedScreen:
        NotificationScreen:
        RecentlyPlayedScreen:
        AlbumScreen:
        ArtistScreen:
        PlaylistScreen:
        BrowseScreen:
        PodcastsScreen:
        MoodScreen:
        EqualizerScreen:
        ListenTogetherScreen:
        AuthScreen:
        FavoritesScreen:

    # Global Mini Player
    MDBoxLayout:
        id: mini_player
        size_hint_y: None
        padding: ["8dp", "0dp", "8dp", "8dp"]
        opacity: 1 if screen_manager.current in ["home", "search", "library", "album", "artist", "playlist", "browse", "podcasts", "mood", "equalizer", "listen_together", "favorites"] else 0
        height: dp(72) if screen_manager.current in ["home", "search", "library", "album", "artist", "playlist", "browse", "podcasts", "mood", "equalizer", "listen_together", "favorites"] else 0
        disabled: False if screen_manager.current in ["home", "search", "library", "album", "artist", "playlist", "browse", "podcasts", "mood", "equalizer", "listen_together", "favorites"] else True
        MDCard:
            style: "elevated"
            size_hint_y: None
            height: "64dp"
            md_bg_color: app.theme_cls.surfaceContainerHighestColor
            on_release: app.switch_screen("player")
            radius: [dp(16)]
            ripple_behavior: True
            MDBoxLayout:
                padding: "8dp"
                spacing: "12dp"
                FitImage:
                    source: app.player_controller.active_track.album_art if app.player_controller.active_track and app.player_controller.active_track.album_art else "album_art.png"
                    size_hint: None, None
                    size: "48dp", "48dp"
                    radius: [dp(8)]
                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    pos_hint: {"center_y": .5}
                    spacing: "2dp"
                    MarqueeLabel:
                        text: app.player_controller.active_track.title if app.player_controller.active_track else "No Track"
                        font_style: "Body"
                        role: "medium"
                        bold: True
                        height: "20dp"
                    MarqueeLabel:
                        text: app.player_controller.active_track.artist if app.player_controller.active_track else "Unknown"
                        font_style: "Body"
                        role: "small"
                        text_color: app.theme_cls.onSurfaceVariantColor
                        height: "16dp"
                MDIconButton:
                    icon: "heart" if app.player_controller.is_favorite else "heart-outline"
                    theme_icon_color: "Custom" if app.player_controller.is_favorite else "Primary"
                    icon_color: [1, 0.2, 0.3, 1] if app.player_controller.is_favorite else app.theme_cls.onSurfaceVariantColor
                    pos_hint: {"center_y": .5}
                    on_release: app.player_controller.toggle_favorite()
                MDIconButton:
                    icon: "pause" if app.player_controller.is_playing else "play"
                    pos_hint: {"center_y": .5}
                    on_release: app.player_controller.toggle_play()

    MDNavigationBar:
        id: bottom_nav
        on_switch_tabs: app.on_switch_tabs(*args)
        size_hint_y: None
        opacity: 1 if screen_manager.current in ["home", "search", "library"] else 0
        height: dp(80) if screen_manager.current in ["home", "search", "library"] else 0
        disabled: False if screen_manager.current in ["home", "search", "library"] else True

        NavBarItem:
            icon: "home"
            text: "Home"
            active: True

        NavBarItem:
            icon: "magnify"
            text: "Search"

        NavBarItem:
            icon: "music-box-multiple"
            text: "Library"
